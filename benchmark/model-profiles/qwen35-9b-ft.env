# qwen35-9b fine-tuned: the base model below with its LoRA adapter (end of the file).
# Qwen3.5 9B post-trained instruction/chat artifact.
# Upstream: Qwen/Qwen3.5-9B; GGUF conversion: unsloth/Qwen3.5-9B-MTP-GGUF.
# The MTP build keeps the multi-token prediction layer inside the artifact, so
# no separate drafter is needed.
LLAMA_MODEL_REPOSITORY=unsloth/Qwen3.5-9B-MTP-GGUF
LLAMA_MODEL_REVISION=9716a636ee4bddc3fed678220b7a33dd2a4160ae
LLAMA_MODEL_FILE=Qwen3.5-9B-Q4_K_M.gguf
LLAMA_MODEL_QUANTIZATION=Q4_K_M
LLAMA_MODEL_SHA256=e8dd94817e95d6c0939102049d068418269978377b13616c4726235e232841fe
LLAMA_MODEL_NAME=Qwen3.5-9B-Q4_K_M-ft

# Multi-token prediction draft length per step, tuned on the evaluation host
# (docs/research/speculative-decoding/README.md).
LLAMA_SPEC_DRAFT_N_MAX=2

# LoRA adapter trained on the Qwen3.5 9B teacher's trajectories (D-060, D-062),
# served next to the unchanged base model file above through the router preset
# benchmark/models-preset.ini. Private repository: downloading needs HF_TOKEN.
# The adapter after epoch 3, converted with the pinned llama.cpp image
# (docs/research/fine-tuning/README.md, "Published adapters").
LLAMA_ADAPTER_REPOSITORY=Nasus20202/qwen35-9b-lora-qwen35-9b-data
LLAMA_ADAPTER_REVISION=355b8890eccd6874dd77817c1271f42ae4fb5adf
LLAMA_ADAPTER_FILE=adapter-f16.gguf
LLAMA_ADAPTER_SHA256=6d852c009fb1cc4342e973471eac8d51b260e062d1736119f2e5442bba258a93

# Base model below plus the LoRA adapter at the end of the file.
# Qwen3.5 4B post-trained instruction/chat artifact.
# Upstream: Qwen/Qwen3.5-4B; GGUF conversion: unsloth/Qwen3.5-4B-MTP-GGUF.
# The MTP build keeps the multi-token prediction layer inside the artifact, so
# no separate drafter is needed.
LLAMA_MODEL_REPOSITORY=unsloth/Qwen3.5-4B-MTP-GGUF
LLAMA_MODEL_REVISION=86835bf9949e4d14d6860f7910b1340ad4f271a9
LLAMA_MODEL_FILE=Qwen3.5-4B-Q4_K_M.gguf
LLAMA_MODEL_QUANTIZATION=Q4_K_M
LLAMA_MODEL_SHA256=3874209241c9a397e2f62cd3f70f80fd2dfbf0dfccb6838416bdb48a714e8630
LLAMA_MODEL_NAME=Qwen3.5-4B-Q4_K_M-lora-qwen35-9b-data

# Multi-token prediction draft length per step, tuned on the evaluation host
# (docs/research/speculative-decoding/README.md).
LLAMA_SPEC_DRAFT_N_MAX=2

# LoRA adapter trained on the Qwen3.5 9B teacher's trajectories (D-060, D-062),
# served next to the unchanged base model file above through the router preset
# benchmark/models-preset.ini. Private repository: downloading needs HF_TOKEN.
# The adapter after epoch 3, converted with the pinned llama.cpp image
# (docs/research/fine-tuning/README.md, "Published adapters").
LLAMA_ADAPTER_REPOSITORY=Nasus20202/qwen35-4b-lora-qwen35-9b-data
LLAMA_ADAPTER_REVISION=45faaf766c3c0fe63a052d18470394be811a91cd
LLAMA_ADAPTER_FILE=adapter-f16.gguf
LLAMA_ADAPTER_SHA256=23cb6a3aacbb6005ce9235db5c5781fea124724cee409b912b60b892adf44e36

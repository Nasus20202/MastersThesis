# DeepSeek V4.1 Flash through its official API: the teacher of the training
# dataset (D-054) and of the validation attempts for the held-out loss.
# The key, OPENAI_API_KEY, stays in the gitignored benchmark/.env. No local
# model server starts for this profile.
INFERENCE_PROVIDER=openai
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-flash
# Default reasoning effort: no reasoning_effort is sent.
OPENAI_REASONING_EFFORT=
# Thinking mode requires the reasoning of earlier turns on tool-calling requests.
OPENAI_REPLAY_REASONING=true

# Base model below plus the LoRA adapter at the end of the file.
# Gemma 4 E4B instruction-tuned QAT artifact, unsloth dynamic 4-bit GGUF.
# Upstream base: google/gemma-4-E4B-it-qat-q4_0-unquantized.
LLAMA_MODEL_REPOSITORY=unsloth/gemma-4-E4B-it-qat-GGUF
LLAMA_MODEL_REVISION=8c5a9e4fd5482e2be20fe0bf013b4c262a8f4265
LLAMA_MODEL_FILE=gemma-4-E4B-it-qat-UD-Q4_K_XL.gguf
LLAMA_MODEL_QUANTIZATION=UD-Q4_K_XL
LLAMA_MODEL_SHA256=df0fd4ee07072c607c29a0a1cb4f98918426cca12f45a2776bdd6ee6d09a4de3
LLAMA_MODEL_NAME=gemma-4-E4B-it-qat-UD-Q4_K_XL-lora-qwen35-9b-data

# Multi-token prediction drafter published in the same repository, attached to
# the target through the router preset benchmark/models-preset.ini.
LLAMA_MODEL_DRAFT_REPOSITORY=unsloth/gemma-4-E4B-it-qat-GGUF
LLAMA_MODEL_DRAFT_REVISION=8c5a9e4fd5482e2be20fe0bf013b4c262a8f4265
LLAMA_MODEL_DRAFT_FILE=MTP/mtp-gemma-4-E4B-it-Q8_0.gguf
LLAMA_MODEL_DRAFT_SHA256=c566f6885963c83a0d868f9656287ed5d4f12a2b8f0c86a20524f89a96169ed2

# Multi-token prediction draft length per step, tuned on the evaluation host
# (docs/research/speculative-decoding/README.md).
LLAMA_SPEC_DRAFT_N_MAX=2

# LoRA adapter trained on the Qwen3.5 9B teacher's trajectories (D-060, D-062),
# served next to the unchanged base model file above through the router preset
# benchmark/models-preset.ini. Private repository: downloading needs HF_TOKEN.
# The adapter after epoch 3, converted with the pinned llama.cpp image
# (docs/research/fine-tuning/README.md, "Published adapters").
LLAMA_ADAPTER_REPOSITORY=Nasus20202/gemma-4-e4b-lora-qwen35-9b-data
LLAMA_ADAPTER_REVISION=b1a8f38558f550f3664b90af1e0af86d474fb4bd
LLAMA_ADAPTER_FILE=adapter-f16.gguf
LLAMA_ADAPTER_SHA256=c8611f84d2e2b0b92890c425e631dcb9a80c3cc5f6d8d4628cff4ecf51b3df10

# gemma-4-e2b fine-tuned: the base model below with its LoRA adapter (end of the file).
# Gemma 4 E2B instruction-tuned QAT artifact, unsloth dynamic 4-bit GGUF.
# Upstream base: google/gemma-4-E2B-it-qat-q4_0-unquantized.
LLAMA_MODEL_REPOSITORY=unsloth/gemma-4-E2B-it-qat-GGUF
LLAMA_MODEL_REVISION=66a399f68ddd113b06dff02fca9523e55465d11d
LLAMA_MODEL_FILE=gemma-4-E2B-it-qat-UD-Q4_K_XL.gguf
LLAMA_MODEL_QUANTIZATION=UD-Q4_K_XL
LLAMA_MODEL_SHA256=e531007218dfab990486a5de7676a6932d6ea8dea233d1f698d7c21cf8a16889
LLAMA_MODEL_NAME=gemma-4-E2B-it-qat-UD-Q4_K_XL-ft

# Multi-token prediction drafter published in the same repository, attached to
# the target through the router preset benchmark/models-preset.ini.
LLAMA_MODEL_DRAFT_REPOSITORY=unsloth/gemma-4-E2B-it-qat-GGUF
LLAMA_MODEL_DRAFT_REVISION=66a399f68ddd113b06dff02fca9523e55465d11d
LLAMA_MODEL_DRAFT_FILE=MTP/mtp-gemma-4-E2B-it-Q8_0.gguf
LLAMA_MODEL_DRAFT_SHA256=6d1d359ac7a5411a046236a1a687f207ebad50475d484235b95946ef329360cc

# Multi-token prediction draft length per step, tuned on the evaluation host
# (docs/research/speculative-decoding/README.md).
LLAMA_SPEC_DRAFT_N_MAX=3

# LoRA adapter trained on the Qwen3.5 9B teacher's trajectories (D-060, D-062),
# served next to the unchanged base model file above through the router preset
# benchmark/models-preset.ini. Private repository: downloading needs HF_TOKEN.
# The adapter after epoch 3, converted with the pinned llama.cpp image
# (docs/research/fine-tuning/README.md, "Published adapters").
LLAMA_ADAPTER_REPOSITORY=Nasus20202/gemma-4-e2b-lora-qwen35-9b-data
LLAMA_ADAPTER_REVISION=c8c9c31d29476ce04c2b0f9ac303fdd70f0152cf
LLAMA_ADAPTER_FILE=adapter-f16.gguf
LLAMA_ADAPTER_SHA256=ae61fc84381f948948e981eda4c512ef5c0b0dd236db56f7d5842939796ef50e

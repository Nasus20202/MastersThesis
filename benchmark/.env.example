# Copy this file to .env and place the model file in the configured directory.
# The model revision intentionally remains provisional and follows main for now.
LLAMA_MODEL_REPOSITORY=google/gemma-4-E4B-it-qat-q4_0-gguf
LLAMA_MODEL_REVISION=main
LLAMA_MODEL_FILE=gemma-4-E4B_q4_0-it.gguf
LLAMA_MODEL_DIR=./models
LLAMA_MODEL_PRESET=./models.ini
LLAMA_MODEL_NAME=gemma-4-e4b

# Runtime settings are provisional and should be recorded with each run.
LLAMA_CONTEXT_SIZE=32768
LLAMA_GPU_LAYERS=99
LLAMA_VULKAN_DEVICE=/dev/dri/renderD128

LLAMA_PARALLEL=1
LLAMA_FLASH_ATTN=auto
LLAMA_CACHE_TYPE_K=f16
LLAMA_CACHE_TYPE_V=f16

LLAMA_HOST=0.0.0.0
LLAMA_PORT=8080
LLAMA_MODELS_MAX=1

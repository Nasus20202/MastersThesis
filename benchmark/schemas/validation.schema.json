{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Nasus20202/MastersThesis/benchmark/schemas/validation.schema.json",
  "title": "Benchmark validation",
  "description": "Validation cases for one scenario (benchmark/scenarios/<id>/validation.yaml).",
  "type": "object",
  "additionalProperties": false,
  "required": ["scenarios"],
  "properties": {
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/scenario" }
    }
  },
  "definitions": {
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scenario_file", "cases"],
      "properties": {
        "scenario_file": {
          "type": "string",
          "minLength": 1,
          "description": "Path to the scenario file, resolved relative to this validation file."
        },
        "cases": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/case" }
        }
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "expected_score", "expected_full_success"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "maxLength": 32
        },
        "repair": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/command" }
        },
        "expected_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "expected_full_success": {
          "type": "boolean"
        }
      }
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["program"],
      "properties": {
        "program": {
          "type": "string",
          "minLength": 1
        },
        "args": {
          "type": "array",
          "items": { "type": "string" }
        },
        "env": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      }
    }
  }
}

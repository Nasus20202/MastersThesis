{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Nasus20202/MastersThesis/benchmark/schemas/scenario.schema.json",
  "title": "Benchmark scenario",
  "description": "A single benchmark scenario (benchmark/scenarios/<id>/scenario.yaml).",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "task", "prepare", "verify_clean", "grading"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 32,
      "description": "Stable identifier; must match the scenario directory name."
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "task": {
      "type": "string",
      "minLength": 1,
      "description": "Model-visible task description."
    },
    "cluster": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "config": {
              "type": "string",
              "minLength": 1,
              "description": "Kind cluster profile, resolved relative to the scenario file."
            }
          }
        }
      }
    },
    "prepare": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/command" }
    },
    "verify_clean": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/command" }
    },
    "inject_fault": {
      "type": "array",
      "items": { "$ref": "#/definitions/command" }
    },
    "verify_fault": {
      "type": "array",
      "items": { "$ref": "#/definitions/command" }
    },
    "grading": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/criterion" }
    }
  },
  "definitions": {
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["program"],
      "properties": {
        "program": {
          "type": "string",
          "minLength": 1
        },
        "args": {
          "type": "array",
          "items": { "type": "string" }
        },
        "env": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      }
    },
    "criterion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "weight", "check"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "maxLength": 32
        },
        "weight": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "check": { "$ref": "#/definitions/command" }
      }
    }
  }
}

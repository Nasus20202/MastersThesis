{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Nasus20202/MastersThesis/benchmark/schemas/config.schema.json",
  "title": "Benchmark configuration",
  "description": "Benchmark-specific settings loaded from benchmark/config.yaml and optional overlays.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "logging": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "level": {
          "type": "string",
          "description": "Log level, for example debug, info, warn or error."
        },
        "format": {
          "type": "string",
          "enum": ["text", "json"]
        },
        "color": {
          "type": "string",
          "description": "Color mode: auto, always or never."
        }
      }
    },
    "agents": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "loop": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "max_turns": { "type": "integer", "minimum": 1 },
            "max_tool_calls": { "type": "integer", "minimum": 1 },
            "tool_timeout_seconds": { "type": "number", "exclusiveMinimum": 0 },
            "timeout_seconds": { "type": "number", "exclusiveMinimum": 0 },
            "max_output_bytes": {
              "type": "integer",
              "minimum": 1,
              "description": "Cap on one bash or read_file result shown to the model, in bytes."
            }
          }
        },
        "prompt": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "system_prompt_file": { "type": "string", "minLength": 1 }
          }
        },
        "skill": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "system_prompt_file": { "type": "string", "minLength": 1 },
            "skills_dir": { "type": "string", "minLength": 1 }
          }
        },
        "rag": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "system_prompt_file": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "containers": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cleanup_timeout_seconds": { "type": "number", "exclusiveMinimum": 0 },
        "sandbox": { "$ref": "#/definitions/container" },
        "setup": { "$ref": "#/definitions/container" }
      }
    },
    "retrieval": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": { "type": "string", "enum": ["lexical", "semantic", "hybrid"] },
        "chunking": { "type": "string", "enum": ["sections", "windows"] },
        "top_k": { "type": "integer", "minimum": 1 },
        "max_bytes": {
          "type": "integer",
          "minimum": 1,
          "description": "Cap on the model-visible search result in bytes."
        },
        "max_chunk_bytes": { "type": "integer", "minimum": 1 },
        "window_overlap": { "type": "integer", "minimum": 0 },
        "hybrid_candidates": { "type": "integer", "minimum": 1 },
        "rrf_k": { "type": "integer", "minimum": 1 },
        "index_dir": {
          "type": "string",
          "minLength": 1,
          "description": "Directory holding the rag-<chunking>.sqlite indexes, relative to the config file."
        }
      }
    }
  },
  "definitions": {
    "container": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "image": { "type": "string", "minLength": 1 },
        "dockerfile": { "type": "string", "minLength": 1 },
        "context": { "type": "string", "minLength": 1 },
        "network": { "type": "string", "minLength": 1 }
      }
    }
  }
}

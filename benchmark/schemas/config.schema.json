{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Nasus20202/MastersThesis/benchmark/schemas/config.schema.json",
  "title": "Benchmark configuration",
  "description": "Benchmark-specific settings loaded from benchmark/config.yaml and optional overlays.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "logging": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "level": {
          "type": "string",
          "description": "Log level, for example debug, info, warn or error."
        },
        "format": {
          "type": "string",
          "enum": ["text", "json"]
        },
        "color": {
          "type": "string",
          "description": "Color mode: auto, always or never."
        }
      }
    },
    "agents": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "loop": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "max_turns": { "type": "integer", "minimum": 1 },
            "max_tool_calls": { "type": "integer", "minimum": 1 },
            "tool_timeout_seconds": { "type": "number", "exclusiveMinimum": 0 },
            "timeout_seconds": { "type": "number", "exclusiveMinimum": 0 }
          }
        },
        "prompt": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "system_prompt_file": { "type": "string", "minLength": 1 }
          }
        },
        "skill": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "system_prompt_file": { "type": "string", "minLength": 1 },
            "skills_dir": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "containers": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sandbox": { "$ref": "#/definitions/container" },
        "setup": { "$ref": "#/definitions/container" }
      }
    }
  },
  "definitions": {
    "container": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "image": { "type": "string", "minLength": 1 },
        "dockerfile": { "type": "string", "minLength": 1 },
        "context": { "type": "string", "minLength": 1 },
        "network": { "type": "string", "minLength": 1 }
      }
    }
  }
}

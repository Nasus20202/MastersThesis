# Selected model artifact. The router model name is the filename without .gguf.
LLAMA_MODEL_REPOSITORY=google/gemma-4-E4B-it-qat-q4_0-gguf
LLAMA_MODEL_REVISION=4b4a2c1d584be7264f87aac328a1bc739ce81b6c
LLAMA_MODEL_FILE=gemma-4-E4B_q4_0-it.gguf
LLAMA_MODEL_DIR=models
LLAMA_MODEL_NAME=gemma-4-E4B_q4_0-it

# Runtime settings are provisional and must be recorded with each run.
LLAMA_CONTEXT_SIZE=32768
LLAMA_GPU_LAYERS=999
LLAMA_VULKAN_DEVICE=/dev/dri/renderD128
LLAMA_PARALLEL=1
LLAMA_FLASH_ATTN=auto
LLAMA_CACHE_TYPE_K=f16
LLAMA_CACHE_TYPE_V=f16
LLAMA_MODELS_MAX=1

# Reasoning defaults for the harder knowledge evaluation. Per-request API
# fields may override these defaults.
LLAMA_REASONING=on
LLAMA_REASONING_BUDGET=4096

# The server listens on all container interfaces but is published locally only.
LLAMA_HOST=0.0.0.0
LLAMA_PORT=8080
LLAMA_PUBLISH_HOST=127.0.0.1
LLAMA_CLIENT_HOST=127.0.0.1

# Retrieval runtime settings: the frozen documentation corpus (D-017) and the
# embedding model served by the llama-embedding service.
CORPUS_REPOSITORY=https://github.com/kubernetes/website.git
CORPUS_REVISION=ea639c1d22a60365d07b78692b1b1a2eb866bd15
CORPUS_SUBTREE=content/en/docs
CORPUS_DIR=corpus

# EmbeddingGemma 300M QAT, Q8_0 GGUF published by the llama.cpp maintainers.
# Upstream base: google/embeddinggemma-300m-qat-q8_0-unquantized.
EMBEDDING_MODEL_REPOSITORY=ggml-org/embeddinggemma-300m-qat-q8_0-GGUF
EMBEDDING_MODEL_REVISION=66f974f8cd48cc3b9c41c516b95508e75b4bee64
EMBEDDING_MODEL_FILE=embeddinggemma-300m-qat-Q8_0.gguf
EMBEDDING_MODEL_QUANTIZATION=Q8_0
EMBEDDING_MODEL_SHA256=6fa0c02a9c302be6f977521d399b4de3a46310a4f2621ee0063747881b673f67
EMBEDDING_MODEL_NAME=embeddinggemma-300m-qat-Q8_0
EMBEDDING_MODEL_DIR=models/embedding

# The embedding server is published locally only, next to llama-server.
EMBEDDING_PORT=8081
EMBEDDING_CTX_SIZE=2048

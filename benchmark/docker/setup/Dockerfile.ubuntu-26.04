FROM ubuntu:26.04@sha256:19fcd1bf268f02b60aca3bd30bd8a6d9a11759a430e32921833e65f16d87348a

# renovate: datasource=github-releases depName=kubernetes/kubernetes
ARG KUBECTL_VERSION=v1.37.0
# renovate: datasource=github-releases depName=helm/helm
ARG HELM_VERSION=v4.3.0

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
    && apt-get install --no-install-recommends --yes \
        bash \
        ca-certificates \
        coreutils \
        curl \
        gawk \
        grep \
        jq \
        sed \
        skopeo \
    && curl --fail --location --retry 3 \
        "https://dl.k8s.io/release/${KUBECTL_VERSION}/bin/linux/amd64/kubectl" \
        --output /usr/local/bin/kubectl \
    && chmod 0755 /usr/local/bin/kubectl \
    && curl --fail --location --retry 3 \
        "https://get.helm.sh/helm-${HELM_VERSION}-linux-amd64.tar.gz" \
        --output /tmp/helm.tar.gz \
    && tar --extract --gzip --file /tmp/helm.tar.gz --directory /tmp \
    && install --mode 0755 /tmp/linux-amd64/helm /usr/local/bin/helm \
    && rm -rf /tmp/helm.tar.gz /tmp/linux-amd64 /var/lib/apt/lists/*

WORKDIR /workspace

FROM ubuntu:26.04@sha256:f144425ff09be612d6d9ad965196e9cdc23dae1f42110a8a11a3e9a8198759f7

# renovate: datasource=github-releases depName=kubernetes/kubernetes
ARG KUBECTL_VERSION=v1.37.0

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
    && apt-get install --no-install-recommends --yes \
        bash \
        ca-certificates \
        coreutils \
        curl \
        jq \
        nodejs \
        python3 \
    && curl --fail --location --retry 3 \
        "https://dl.k8s.io/release/${KUBECTL_VERSION}/bin/linux/amd64/kubectl" \
        --output /usr/local/bin/kubectl \
    && chmod 0755 /usr/local/bin/kubectl \
    && rm -rf /var/lib/apt/lists/*

RUN useradd --create-home --home-dir /home/benchmark --shell /bin/bash benchmark \
    && install --directory --owner=benchmark --group=benchmark /home/benchmark/.kube /workspace

COPY --chmod=0755 no-editor /usr/local/bin/no-editor

ENV HOME=/home/benchmark
ENV KUBE_EDITOR=/usr/local/bin/no-editor

WORKDIR /workspace
USER benchmark

+	"time"
 
 	"github.com/Nasus20202/MastersThesis/benchmark/internal/agent/common"
 	"github.com/Nasus20202/MastersThesis/benchmark/internal/integrations/inference"
@@ -31,6 +32,9 @@ type Search struct {
 	Mode     retrieval.Mode
 	TopK     int
 	MaxBytes int
+	// TaskSearch searches once with the task text before the first turn and
+	// appends the excerpts to the task message.
+	TaskSearch bool
 }
 
 // New builds the RAG condition. A blank systemPrompt uses the embedded
@@ -46,7 +50,26 @@ func New(client inference.Client, shell common.Shell, config common.Config, syst
 	if err != nil {
 		return nil, err
 	}
-	return common.NewCondition("rag", client, []common.Tool{bash, searchTool{search: search}}, config, systemPrompt, nil)
+	var formatTask func(string) string
+	if search.TaskSearch {
+		formatTask = search.withTaskExcerpts
+	}
+	return common.NewCondition("rag", client, []common.Tool{bash, searchTool{search: search}}, config, systemPrompt, formatTask)
+}
+
+const taskSearchTimeout = 30 * time.Second
+
+// withTaskExcerpts leaves the task unchanged when the search fails, so a
+// retrieval outage degrades to R1 instead of failing the attempt.
+func (s *Search) withTaskExcerpts(task string) string {
+	ctx, cancel := context.WithTimeout(context.Background(), taskSearchTimeout)
+	defer cancel()
+	hits, err := s.Index.Search(ctx, s.Embedder, s.Mode, task, s.TopK)
+	if err != nil || len(hits) == 0 {
+		return task
+	}
+	content, _ := retrieval.Render(hits, s.MaxBytes)
+	return task + "\n\nDocumentation excerpts found by searching the official Kubernetes documentation with the task text. They may not describe this cluster's cause; check them against your observations.\n\n" + content
 }
 
 type searchTool struct{ search *Search }
diff --git a/benchmark/internal/agent/rag/rag_test.go b/benchmark/internal/agent/rag/rag_test.go
index 5113b20..898672c 100644
--- a/benchmark/internal/agent/rag/rag_test.go
+++ b/benchmark/internal/agent/rag/rag_test.go
@@ -144,3 +144,21 @@ func TestSearchToolReportsErrors(t *testing.T) {
 	assert.True(t, strings.HasPrefix(result.Content, "search failed:"))
 	assert.Equal(t, "volume", result.Details.(SearchEvidence).Query)
 }
+
+func TestTaskSearchAppendsExcerptsToTheTask(t *testing.T) {
+	search := testSearch(t)
+	search.TaskSearch = true
+	client := &ragTestClient{}
+	condition, err := New(client, ragTestShell{}, common.Config{MaxTurns: 1, MaxToolCalls: 1}, "", search)
+	require.NoError(t, err)
+	_, err = condition.Run(context.Background(), "A volume claim is pending.")
+	require.NoError(t, err)
+	task := client.messages[len(client.messages)-1].Content
+	assert.True(t, strings.HasPrefix(task, "A volume claim is pending.\n\nDocumentation excerpts"))
+	assert.Contains(t, task, "[1] docs/storage.md")
+
+	search.Embedder = wordEmbedder{err: errors.New("down")}
+	_, err = condition.Run(context.Background(), "A volume claim is pending.")
+	require.NoError(t, err)
+	assert.Equal(t, "A volume claim is pending.", client.messages[len(client.messages)-1].Content)
+}

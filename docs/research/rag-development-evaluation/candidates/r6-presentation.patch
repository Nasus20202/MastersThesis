+
+// RenderOutlined is Render with HTML reduced to plain text and, after the
+// first excerpt from each page, the page's section headings, so the model can
+// see what else the page covers and search for it.
+func RenderOutlined(hits []Hit, maxBytes int, outlines map[string][]string) (string, bool) {
+	if outlines == nil {
+		outlines = map[string][]string{}
+	}
+	return render(hits, maxBytes, outlines)
+}
+
+func render(hits []Hit, maxBytes int, outlines map[string][]string) (string, bool) {
 	if len(hits) == 0 {
 		return noResults, false
 	}
 	blocks := make([]string, len(hits))
+	listed := map[string]bool{}

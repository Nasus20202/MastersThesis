+func TestRenderOutlinedListsEachPageOnceAsPlainText(t *testing.T) {
+	hits := []Hit{
+		{Rank: 1, Chunk: Chunk{Path: "docs/a.md", Title: "A", Body: "<tr><td><code>spec</code></td><td>Desired &amp; state</td></tr>\n```\n<keep>\n```"}},
+		{Rank: 2, Chunk: Chunk{Path: "docs/a.md", Title: "A", Headings: "Sub", Body: "Use <name>."}},
+	}
+	outlines := map[string][]string{"docs/a.md": {"Spec {#spec}", "Spec > Taints", "Spec > Taints > Effects"}}
+	rendered, truncated := RenderOutlined(hits, 1000, outlines)
+	assert.False(t, truncated)
+	assert.Equal(t, "[1] docs/a.md\nA\nspec | Desired & state\n```\n<keep>\n```\nSections of this page: Spec; Spec > Taints\n\n[2] docs/a.md\nA > Sub\nUse <name>.", rendered)
+
+	long := map[string][]string{"docs/a.md": {"Spec", strings.Repeat("x", maxOutlineBytes)}}
+	rendered, _ = RenderOutlined(hits[:1], 10000, long)
+	assert.True(t, strings.HasSuffix(rendered, "Sections of this page: Spec; ..."))
+}
+
+func TestOutlinesListDistinctHeadingsPerPage(t *testing.T) {
+	outlines, err := buildTestIndex(t, &topicEmbedder{}).Outlines(context.Background())
+	require.NoError(t, err)
+	assert.Equal(t, []string{"Claims"}, outlines["docs/storage.md"])
+	assert.Len(t, outlines, 3)
+}

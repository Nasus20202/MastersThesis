+
+// Outlines lists each document's section headings in document order.
+func (i *Index) Outlines(ctx context.Context) (map[string][]string, error) {
+	rows, err := i.db.QueryContext(ctx, selectOutlinesSQL)
+	if err != nil {
+		return nil, fmt.Errorf("load outlines: %w", err)
+	}
+	defer rows.Close()
+	outlines := make(map[string][]string)
+	for rows.Next() {
+		var path, headings string
+		if err := rows.Scan(&path, &headings); err != nil {
+			return nil, err
+		}
+		if !slices.Contains(outlines[path], headings) {
+			outlines[path] = append(outlines[path], headings)
+		}
+	}
+	return outlines, rows.Err()
+}

+		text := hit.Chunk.Rendered()
+		if outlines != nil {
+			text = plainText(text)
+			if !listed[hit.Chunk.Path] {
+				listed[hit.Chunk.Path] = true
+				text += outline(outlines[hit.Chunk.Path])
+			}
+		}
+		blocks[index] = fmt.Sprintf("[%d] %s", hit.Rank, text)
 	}
 	result := strings.Join(blocks, "\n\n")
 	if len(result) <= maxBytes {
@@ -27,3 +55,59 @@ func Render(hits []Hit, maxBytes int) (string, bool) {
 	cut := max(maxBytes-len(truncatedLabel), 0)
 	return result[:runeBoundary(result, cut)] + truncatedLabel, true
 }
+
+func outline(headings []string) string {
+	if len(headings) == 0 {
+		return ""
+	}
+	var listed strings.Builder
+	for _, heading := range headings {
+		// Two levels name what a page covers; deeper ones are mostly API
+		// operation details.
+		if strings.Count(heading, " > ") > 1 {
+			continue
+		}
+		heading = headingAnchor.ReplaceAllString(heading, "")
+		if strings.Contains(listed.String(), heading+"; ") {
+			continue
+		}
+		if listed.Len()+len(heading) > maxOutlineBytes {
+			listed.WriteString("...")
+			break
+		}
+		listed.WriteString(heading + "; ")
+	}
+	return "\nSections of this page: " + strings.TrimSuffix(listed.String(), "; ")
+}
+
+var (
+	headingAnchor = regexp.MustCompile(`\s*\{#[^}]*\}`)
+	cellBoundary = regexp.MustCompile(`(?i)</t[hd]>\s*<t[hd][^>]*>`)
+	// htmlTag lists the tags the corpus uses for tables, links and inline
+	// formatting, so placeholders such as <name> in prose are kept.
+	htmlTag = regexp.MustCompile(`(?i)</?(?:table|thead|tbody|tfoot|tr|th|td|caption|colgroup|col|a|br|hr|p|div|span|code|em|strong|b|i|ul|ol|li|sup|sub)\b[^>]*>`)
+)
+
+// plainText turns the HTML some pages keep, mostly API reference tables, into
+// plain lines (table cells joined by " | "), leaving code fences unchanged.
+func plainText(text string) string {
+	lines := strings.Split(text, "\n")
+	kept := lines[:0]
+	fenced := false
+	for _, line := range lines {
+		if strings.HasPrefix(strings.TrimSpace(line), "```") {
+			fenced = !fenced
+		}
+		if fenced || !strings.Contains(line, "<") {
+			kept = append(kept, line)
+			continue
+		}
+		plain := htmlTag.ReplaceAllString(cellBoundary.ReplaceAllString(line, " | "), "")
+		plain = strings.TrimRight(html.UnescapeString(plain), " \t")
+		if strings.TrimSpace(plain) == "" && strings.TrimSpace(line) != "" {
+			continue
+		}
+		kept = append(kept, plain)
+	}
+	return strings.Join(kept, "\n")
+}

+
+// renderPage shows one page: its title and path, then each excerpt under its
+// heading path. Chunk IDs follow the page order within a document.
+func renderPage(number int, hits []Hit) string {
+	hits = slices.Clone(hits)
+	slices.SortFunc(hits, func(a, b Hit) int { return cmp.Compare(a.ChunkID, b.ChunkID) })
+	var builder strings.Builder
+	fmt.Fprintf(&builder, "[%d] %s (%s)", number, hits[0].Chunk.Title, hits[0].Chunk.Path)
+	var previous Hit
+	var body string
+	flush := func() {
+		if body == "" {
+			return
+		}
+		if headings := stripAnchors(previous.Chunk.Headings); headings != "" {
+			builder.WriteString("\n§ " + headings)
+		}
+		builder.WriteString("\n" + body)
+	}
+	for _, hit := range hits {
+		text := stripAnchors(hit.Chunk.Body)
+		adjacent := body != "" && hit.ChunkID == previous.ChunkID+1
+		if adjacent {
+			if merged, ok := joinOverlapping(body, text); ok {
+				body = merged
+				previous.ChunkID = hit.ChunkID
+				continue
+			}
+		}
+		flush()
+		if body != "" && !adjacent {
+			builder.WriteString("\n…")
+		}
+		previous, body = hit, text
+	}
+	flush()
+	return builder.String()
+}
+
+// joinOverlapping appends next to text without repeating the window overlap.
+// It fails when next does not start with a suffix of text, as for sections.
+func joinOverlapping(text, next string) (string, bool) {
+	for size := min(len(text), len(next), 2*WindowOverlap); size > 0; size-- {
+		if strings.HasSuffix(text, next[:size]) {
+			return text + next[size:], true
+		}
+	}
+	return "", false
+}
+
+var headingAnchor = regexp.MustCompile(`\s*\{#[^}]*\}`)
+
+func stripAnchors(text string) string {
+	return headingAnchor.ReplaceAllString(text, "")
+}

{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "ignorePaths": ["benchmark/scenarios/**"],
  "packageRules": [
    {
      "description": "Automerge minor and patch updates",
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true
    },
    {
      "description": "Update llama.cpp server images on demand",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/ggml-org/llama.cpp"],
      "matchCurrentValue": "/^server-vulkan-b\\d+$/",
      "versioning": "regex:^server-vulkan-b(?<major>\\d+)$",
      "dependencyDashboardApproval": true
    },
    {
      "description": "Check development npm dependencies weekly",
      "matchManagers": ["npm"],
      "matchDepTypes": ["devDependencies"],
      "schedule": ["* * * * 0"]
    }
  ]
}

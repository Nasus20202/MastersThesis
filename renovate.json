{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "packageRules": [
    {
      "description": "Automerge minor, patch, and digest updates",
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "automerge": true
    },
    {
      "description": "Update llama.cpp server images on demand",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/ggml-org/llama.cpp"],
      "matchCurrentValue": "/^server-vulkan-b\\d+$/",
      "versioning": "regex:^server-vulkan-b(?<major>\\d+)$",
      "dependencyDashboardApproval": true
    },
    {
      "description": "Update benchmark Kubernetes tooling on demand",
      "matchDatasources": ["github-releases", "docker"],
      "matchPackageNames": [
        "kubernetes-sigs/kind",
        "kubernetes/kubernetes",
        "kindest/node",
        "helm/helm"
      ],
      "dependencyDashboardApproval": true,
      "automerge": false,
      "groupName": "benchmark Kubernetes tooling"
    },
    {
      "description": "Update Kubernetes manifests on demand",
      "matchManagers": ["kubernetes"],
      "dependencyDashboardApproval": true,
      "automerge": false,
      "groupName": "benchmark Kubernetes manifests"
    },
    {
      "description": "Update benchmark cluster add-ons on demand",
      "matchDatasources": ["helm", "github-releases"],
      "matchPackageNames": [
        "traefik",
        "tigera-operator",
        "crd.projectcalico.org.v1",
        "kubernetes-sigs/gateway-api"
      ],
      "dependencyDashboardApproval": true,
      "automerge": false,
      "groupName": "benchmark cluster add-ons"
    },
    {
      "description": "Check development npm dependencies weekly",
      "matchManagers": ["npm"],
      "matchDepTypes": ["devDependencies"],
      "schedule": ["* 0-7 * * 0"],
      "groupName": "development npm dependencies"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/(^|\\/).*\\.ya?ml$/"],
      "matchStrings": [
        "image:\\s*(?<depName>kindest/node):(?<currentValue>v\\d+\\.\\d+\\.\\d+)(?:@(?<currentDigest>sha256:[a-f0-9]+))?"
      ],
      "autoReplaceStringTemplate": "image: {{{depName}}}:{{{newValue}}}{{#if newDigest}}@{{{newDigest}}}{{/if}}",
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github\\/workflows\\/.*\\.ya?ml$/",
        "/(^|\\/)Dockerfile(?:\\..*)?$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>github-releases) depName=(?<depName>[^\\s]+)\\s+(?:version:|kubectl_version:|ARG KUBECTL_VERSION=|ARG HELM_VERSION=)\\s*['\"]?(?<currentValue>v\\d+\\.\\d+\\.\\d+)['\"]?"
      ]
    },
    {
      "customType": "regex",
      "description": "Update Helm chart versions pinned in scenario prepare steps",
      "managerFilePatterns": ["/^benchmark\\/scenarios\\/.*\\.ya?ml$/"],
      "matchStrings": [
        "# renovate: datasource=helm depName=(?<depName>\\S+) registryUrl=(?<registryUrl>\\S+)\\s*\\n\\s*-\\s*(?<currentValue>v?\\d+\\.\\d+\\.\\d+)"
      ],
      "datasourceTemplate": "helm"
    },
    {
      "customType": "regex",
      "description": "Update pinned GitHub release manifests referenced in scenario prepare steps",
      "managerFilePatterns": ["/^benchmark\\/scenarios\\/.*\\.ya?ml$/"],
      "matchStrings": [
        "# renovate: datasource=github-releases depName=(?<depName>\\S+)\\s*\\n\\s*-\\s*https://github\\.com/\\S+/releases/download/(?<currentValue>v\\d+\\.\\d+\\.\\d+)/"
      ],
      "datasourceTemplate": "github-releases"
    }
  ]
}
